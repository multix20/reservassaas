# Copia este archivo a .env y completa con tus valores reales.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# ─────────────────────────────────────────────────────────────
# Los siguientes NO van aquí: son secrets del servidor.
# Configúralos con `supabase secrets set` para la Edge Function
# de pagos (supabase/functions/flow-payment):
#
#   FLOW_API_KEY, FLOW_SECRET, FLOW_API_URL,
#   SITE_URL, SB_URL, SB_SERVICE_ROLE_KEY
#
# Nunca los expongas con prefijo VITE_ — eso los publica en el
# bundle que descarga el navegador.
